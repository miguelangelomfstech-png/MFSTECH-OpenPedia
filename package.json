{
  "name": "mfstech-openpedia",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=22.9" },
  "scripts": {
    "dev": "pnpm --parallel --filter @wiki/web --filter @wiki/worker dev",
    "dev:web": "pnpm --filter @wiki/web dev",
    "dev:worker": "pnpm --filter @wiki/worker dev",
    "build": "pnpm --filter @wiki/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @wiki/db generate",
    "db:migrate": "pnpm --filter @wiki/db migrate",
    "db:seed": "pnpm --filter @wiki/db seed",
    "infra:up": "docker compose up -d postgres redis meilisearch minio",
    "infra:down": "docker compose down"
  }
}
