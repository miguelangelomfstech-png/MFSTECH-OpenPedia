# ==============================================================================
# MFSTECH-OpenPedia - Production Environment Configuration Template
# ==============================================================================
NODE_ENV=production
SITE_NAME=MFSTECH-OpenPedia
SITE_URL=https://wiki.example.com
SITE_DOMAIN=wiki.example.com
ACME_EMAIL=admin@example.com

# Authentication (openssl rand -hex 32)
AUTH_SECRET=generate-a-strong-random-secret-key-32chars
AUTH_TRUST_HOST=true

# Database (PostgreSQL 16)
POSTGRES_USER=wiki
POSTGRES_PASSWORD=generate-a-strong-postgres-password
POSTGRES_DB=wiki
DATABASE_URL=postgres://wiki:generate-a-strong-postgres-password@postgres:5432/wiki

# Cache & Queues (Redis 7)
REDIS_PASSWORD=generate-a-strong-redis-password
REDIS_URL=redis://:generate-a-strong-redis-password@redis:6379

# Search Engine (Meilisearch v1.11)
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=generate-a-strong-meili-master-key-32chars

# Media Storage (Cloudflare R2 or MinIO)
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_PRESIGN_ENDPOINT=
S3_REGION=auto
S3_BUCKET=wiki-media
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=https://media.example.com

# Worker Concurrency
WORKER_CONCURRENCY_VIDEO=2
WORKER_CONCURRENCY_IMAGE=4
MAX_IMAGE_MB=25
MAX_VIDEO_MB=1024
