# ---- Site ----
SITE_URL=http://localhost:3000
SITE_NAME=MFSTECH-OpenPedia

# ---- Database ----
DATABASE_URL=postgres://wiki:wiki@localhost:5432/wiki

# ---- Redis (cache, rate limit, BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Search (Meilisearch) ----
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev-master-key-change-me-please-32chars

# ---- Object storage (MinIO locally; R2/S3 in production) ----
S3_ENDPOINT=http://localhost:9000
# Optional: endpoint the BROWSER uses for presigned uploads (defaults to S3_ENDPOINT)
S3_PRESIGN_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=wiki-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Public base URL for reading media (CDN in production), no trailing slash
S3_PUBLIC_BASE_URL=http://localhost:9000/wiki-media

# ---- Auth.js ----
# Generate: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# OAuth providers are enabled when both values are set
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Worker ----
WORKER_CONCURRENCY_VIDEO=1
WORKER_CONCURRENCY_IMAGE=4
MAX_IMAGE_MB=25
MAX_VIDEO_MB=1024
